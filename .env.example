# IMPORTANT: Vite bakes these values in at BUILD time, not at runtime.
# Setting them only in a hosted .env file does nothing — you must add them as
# actual environment variables in your hosting provider's dashboard
# (Vercel: Project Settings -> Environment Variables, Netlify: Site settings ->
# Environment variables) BEFORE triggering a build, then redeploy.
#
# Point these at your deployed backend, not localhost, once it's live, e.g.:
# VITE_API_URL=https://queueless-api.onrender.com/api
# VITE_SOCKET_URL=https://queueless-api.onrender.com
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
